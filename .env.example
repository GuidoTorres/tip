# App y Supabase
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_PUBLISHABLE_O_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=TU_SECRET_O_SERVICE_ROLE_KEY

# Comision de TipMe en puntos base (100 = 1%)
PLATFORM_FEE_BPS=0

# Proveedor de pagos activo: paypal
# Solo hacen falta las credenciales del proveedor elegido; el resto puede
# quedarse con estos valores de ejemplo.
PAYMENT_PROVIDER=paypal

# Proveedor simulado (desarrollo): ningun cobro es real
MOCK_WEBHOOK_SECRET=GENERA_UN_SECRETO_DE_16_CARACTERES_O_MAS

# PayPal
# PAYPAL_FLOW=platform_payouts -> TipMe cobra y luego paga a la creadora (custodia)
# PAYPAL_FLOW=multiparty       -> el fan paga directo a la creadora (requiere partner)
PAYPAL_ENVIRONMENT=live
PAYPAL_FLOW=platform_payouts
PAYPAL_SANDBOX_SINGLE_MERCHANT=false
PAYPAL_PAYOUT_FEE_BPS=200
PAYPAL_PAYOUT_FEE_CAP_MINOR=100
PAYPAL_CHECKOUT_FEE_BPS=540
PAYPAL_CHECKOUT_FIXED_FEE_MINOR=30
PAYPAL_SANDBOX_PAYOUT_RECIPIENT_ID=fake-sandbox-paypal-account-id
NEXT_PUBLIC_PAYPAL_CLIENT_ID=fake-paypal-client-id-replace-me
PAYPAL_CLIENT_SECRET=fake-paypal-client-secret-replace-me
PAYPAL_WEBHOOK_ID=fake-paypal-webhook-id-replace-me
PAYPAL_PARTNER_MERCHANT_ID=fake-paypal-partner-merchant-id-replace-me
PAYPAL_PARTNER_ATTRIBUTION_ID=

# Minutos de retencion antes de habilitar un retiro (0 = sin retencion)
PAYOUT_HOLD_MINUTES=0

# dLocal Go
DLOCALGO_ENVIRONMENT=sandbox
DLOCALGO_API_KEY=fake-dlocalgo-api-key-replace-me
DLOCALGO_SECRET_KEY=fake-dlocalgo-secret-key-replace-me

# Mercado Pago: una aplicacion OAuth por pais.
# Clave AES-256 en base64 (32 bytes) para cifrar los tokens de vendedor.
# Generala con: openssl rand -base64 32
MERCADOPAGO_ENVIRONMENT=sandbox
PAYMENT_TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
MERCADOPAGO_AR_CLIENT_ID=fake-mp-ar-client-id-replace-me
MERCADOPAGO_AR_CLIENT_SECRET=fake-mp-ar-client-secret-replace-me
NEXT_PUBLIC_MERCADOPAGO_AR_PUBLIC_KEY=fake-mp-ar-public-key-replace-me
MERCADOPAGO_AR_WEBHOOK_SECRET=fake-mp-ar-webhook-secret-replace-me
MERCADOPAGO_BR_CLIENT_ID=fake-mp-br-client-id-replace-me
MERCADOPAGO_BR_CLIENT_SECRET=fake-mp-br-client-secret-replace-me
NEXT_PUBLIC_MERCADOPAGO_BR_PUBLIC_KEY=fake-mp-br-public-key-replace-me
MERCADOPAGO_BR_WEBHOOK_SECRET=fake-mp-br-webhook-secret-replace-me
MERCADOPAGO_CL_CLIENT_ID=fake-mp-cl-client-id-replace-me
MERCADOPAGO_CL_CLIENT_SECRET=fake-mp-cl-client-secret-replace-me
NEXT_PUBLIC_MERCADOPAGO_CL_PUBLIC_KEY=fake-mp-cl-public-key-replace-me
MERCADOPAGO_CL_WEBHOOK_SECRET=fake-mp-cl-webhook-secret-replace-me
MERCADOPAGO_CO_CLIENT_ID=fake-mp-co-client-id-replace-me
MERCADOPAGO_CO_CLIENT_SECRET=fake-mp-co-client-secret-replace-me
NEXT_PUBLIC_MERCADOPAGO_CO_PUBLIC_KEY=fake-mp-co-public-key-replace-me
MERCADOPAGO_CO_WEBHOOK_SECRET=fake-mp-co-webhook-secret-replace-me
MERCADOPAGO_MX_CLIENT_ID=fake-mp-mx-client-id-replace-me
MERCADOPAGO_MX_CLIENT_SECRET=fake-mp-mx-client-secret-replace-me
NEXT_PUBLIC_MERCADOPAGO_MX_PUBLIC_KEY=fake-mp-mx-public-key-replace-me
MERCADOPAGO_MX_WEBHOOK_SECRET=fake-mp-mx-webhook-secret-replace-me
MERCADOPAGO_PE_CLIENT_ID=fake-mp-pe-client-id-replace-me
MERCADOPAGO_PE_CLIENT_SECRET=fake-mp-pe-client-secret-replace-me
NEXT_PUBLIC_MERCADOPAGO_PE_PUBLIC_KEY=fake-mp-pe-public-key-replace-me
MERCADOPAGO_PE_WEBHOOK_SECRET=fake-mp-pe-webhook-secret-replace-me
MERCADOPAGO_UY_CLIENT_ID=fake-mp-uy-client-id-replace-me
MERCADOPAGO_UY_CLIENT_SECRET=fake-mp-uy-client-secret-replace-me
NEXT_PUBLIC_MERCADOPAGO_UY_PUBLIC_KEY=fake-mp-uy-public-key-replace-me
MERCADOPAGO_UY_WEBHOOK_SECRET=fake-mp-uy-webhook-secret-replace-me

# Recibos firmados
RECEIPT_SIGNING_SECRET=GENERA_UN_SECRETO_DE_16_CARACTERES_O_MAS

# Notificaciones push (Web Push / VAPID)
# Genera el par con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=REEMPLAZAR
VAPID_PRIVATE_KEY=REEMPLAZAR
VAPID_SUBJECT=mailto:admin@tipme.pro

# Datos del operador que aparecen en terminos, privacidad y reembolsos
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
